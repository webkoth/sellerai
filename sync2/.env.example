# Рабочая база синка
DATABASE_URL=postgres://localhost:5432/sync2
# Тестовая база: тесты *.db.test.ts стирают её схему целиком — никогда не указывать рабочую
TEST_DATABASE_URL=postgres://localhost:5432/sync2_test
# Глобальный режим записи на площадки: off | dry-run | apply. По умолчанию off.
SYNC_WRITE_MODE=off
LOG_LEVEL=info

# Ключи и склады четырёх площадок для адаптеров чтения (probe и далее) —
# те же ключи, что у старого синка (/opt/sellerai-sync/.env).
WB_API_TOKEN=
OZON_CLIENT_ID=
OZON_API_TOKEN=
YM_API_TOKEN=
YM_BUSINESS_ID=
YM_CAMPAIGN_ID=
# YM_WAREHOUSE_IDS — склад магазина ИП 2369574
YM_WAREHOUSE_IDS=2369574
YAKIT_API_TOKEN=
# KIT_WAREHOUSE_ID — склад продаж «Склад Краснодар»
KIT_WAREHOUSE_ID=01980d4c-1b53-7aa1-ab23-1b7c23604704
