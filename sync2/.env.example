# Рабочая база синка
DATABASE_URL=postgres://localhost:5432/sync2
# Тестовая база: тесты *.db.test.ts стирают её схему целиком — никогда не указывать рабочую
TEST_DATABASE_URL=postgres://localhost:5432/sync2_test
# Глобальный режим записи на площадки: off | dry-run | apply. На VPS в 1.3b — dry-run.
SYNC_WRITE_MODE=off
LOG_LEVEL=info

# Ключи и склады площадок для адаптеров чтения (probe и далее) —
# те же ключи, что у старого синка (/opt/sellerai-sync/.env).
WB_API_TOKEN=
OZON_CLIENT_ID=
OZON_API_TOKEN=
YM_API_TOKEN=
YM_BUSINESS_ID=
YM_CAMPAIGN_ID=
# YM_WAREHOUSE_IDS — склад магазина ИП 2369574
YM_WAREHOUSE_IDS=2369574
YAKIT_API_TOKEN=
# KIT_WAREHOUSE_ID — склад продаж «Склад Краснодар»
KIT_WAREHOUSE_ID=01980d4c-1b53-7aa1-ab23-1b7c23604704

# Telegram — уведомления о смене состояния джоб (ingest/pool) и сводка compare-v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004395280612
# V1_LEDGER_PATH — леджер старого синка для джобы compare-v1
V1_LEDGER_PATH=/opt/sellerai-sync/data/state/inventory.json

# Сайт kotelnikovartifact.ru (этап 1.3c) — служебный API сайта. Без токена сайт в синк не подключается.
# SITE_API_TOKEN = INTERNAL_API_TOKEN из .env сайта (201.34.133.76), не короче 32 символов; не печатать.
SITE_API_URL=https://kotelnikovartifact.ru
SITE_API_TOKEN=

# Этап 1.4 — склады, на которые sync2 пишет остаток (без них запись WB/Ozon невозможна, чтение работает).
WB_WAREHOUSE_ID=1408913
OZON_WAREHOUSE_ID=1020005023618600
