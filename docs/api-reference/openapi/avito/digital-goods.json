ate-time","type":"string"},"id":{"description":"Идентификатор заказа","example":"019a5dc0-0677-7f77-b0a6-e99dd3b68fa1","format":"uuid","type":"string"},"item":{"$ref":"#/components/schemas/orderItem"},"price":{"$ref":"#/components/schemas/orderPrice"},"product":{"description":"Цифровой товар","example":"Код активации: ABCD-EFGH-IJKL","nullable":true,"type":"string"},"seller_type":{"$ref":"#/components/schemas/sellerType"},"status":{"$ref":"#/components/schemas/statusInfo"},"updated_at":{"description":"Время последнего обновления заказа","example":"2026-07-03T09:15:00Z","format":"date-time","type":"string"}},"required":["id","code","status","item","price","seller_type","created_at","updated_at"],"type":"object"},"orderActionResponse":{"properties":{"order_id":{"example":"019a5dc0-0677-7f77-b0a6-e99dd3b68fa1","format":"uuid","type":"string"},"status":{"$ref":"#/components/schemas/statusInfo"}},"required":["order_id","status"],"title":"okOrderActionResponse","type":"object"},"orderHistoryItem":{"properties":{"occurred_at":{"description":"Время перехода между статусами","example":"2026-07-03T09:15:00Z","format":"date-time","type":"string"},"status_from":{"description":"Предыдущий статус заказа (строковое значение)","example":"in_progress","type":"string"},"status_to":{"description":"Новый статус заказа (строковое значение)","example":"sent","type":"string"}},"required":["status_from","status_to","occurred_at"],"type":"object"},"orderHistoryResponse":{"properties":{"history":{"items":{"$ref":"#/components/schemas/orderHistoryItem"},"type":"array"},"order_id":{"example":"019a5dc0-0677-7f77-b0a6-e99dd3b68fa1","format":"uuid","type":"string"}},"required":["order_id","history"],"title":"okOrderHistoryResponse","type":"object"},"orderItem":{"properties":{"id":{"description":"Идентификатор объявления","example":123456789,"format":"int64","type":"integer"},"title":{"description":"Название объявления","example":"Подарочная карта","nullable":true,"type":"string"}},"required":["id"],"type":"object"},"orderPrice":{"properties":{"commission":{"description":"Комиссия в копейках","example":7500,"format":"int64","nullable":true,"type":"integer"},"discount":{"description":"Размер скидки в копейках","example":0,"format":"int64","nullable":true,"type":"integer"},"total":{"description":"Итоговая стоимость заказа в копейках","example":150000,"format":"int64","type":"integer"}},"required":["total"],"type":"object"},"orderStatus":{"description":"Статус заказа.\n\n`in_progress` — оплачен, ждёт отправки товара продавцом; `sent` — товар отправлен покупателю; `dispute` — покупатель открыл спор; `arbitration` — спор передан в арбитраж Авито; `canceled_by_buyer`, `canceled_by_seller`, `canceled_by_avito`, `canceled_by_arbitrator`, `canceled` — заказ отменён; `completed_by_buyer`, `completed_by_avito`, `completed_by_arbitrator`, `completed` — заказ завершён.\n","enum":["in_progress","sent","dispute","arbitration","canceled_by_buyer","canceled_by_seller","canceled_by_avito","canceled_by_arbitrator","completed_by_arbitrator","completed_by_buyer","completed_by_avito","canceled","completed"],"example":"in_progress","type":"string"},"ordersResponse":{"properties":{"orders":{"items":{"$ref":"#/components/schemas/order"},"type":"array"},"pagination":{"$ref":"#/components/schemas/pagination"}},"required":["orders","pagination"],"title":"okOrdersResponse","type":"object"},"pagination":{"properties":{"hasMore":{"description":"Признак наличия следующей страницы","example":false,"type":"boolean"},"limit":{"example":100,"format":"int32","type":"integer"},"offset":{"example":0,"format":"int32","type":"integer"}},"type":"object"},"payoutResponse":{"properties":{"url":{"description":"Ссылка на вывод средств","example":"https://www.avito.ru/payout","format":"uri","type":"string"}},"required":["url"],"title":"okPayoutResponse","type":"object"},"sellerType":{"description":"Тип продавца — компания (`b2c`) или частное лицо (`c2c`)","enum":["b2c","c2c","unknown"],"example":"c2c","type":"string"},"sendProductRequest":{"properties":{"product":{"description":"Текстовая инструкция или код для покупателя","example":"Код активации: CODE-123-456. Инструкция по использованию: откройте страницу активации и введите код.","type":"string"}},"required":["product"],"title":"sendProductRequestBody","type":"object"},"statusInfo":{"properties":{"terminal":{"description":"Признак терминального статуса","example":false,"type":"boolean"},"title":{"description":"Человекочитаемое название статуса","example":"Ожидает отправки товара","type":"string"},"value":{"$ref":"#/components/schemas/orderStatus"}},"required":["value","title","terminal"],"type":"object"},"successResponse":{"properties":{"success":{"description":"Действие выполнено","type":"object"}},"required":["success"],"title":"okResponse","type":"object"},"webhookRequest":{"properties":{"secret":{"description":"Секрет продавца для подписи webhook-уведомлений","example":"f9c2a7d4e8b1c6a3f0d9e2b5a8c1d4f7","maxLength":128,"minLength":16,"type":"string"},"url":{"description":"URL продавца, на который будут отправляться уведомления по заказам цифровых товаров","example":"https://seller.example.com/digital-goods/v1/orders/events","format":"uri","type":"string"}},"required":["url","secret"],"title":"requestBody","type":"object"}},"securitySchemes":{"ClientCredentials":{"description":"Персональная авторизация продавца. [Как получить токен](https://developers.avito.ru/api-catalog/auth/documentation)","flows":{"clientCredentials":{"scopes":{},"tokenUrl":"https://api.avito.ru/token"}},"type":"oauth2"}}},"info":{"description":"API цифровых товаров — набор методов для продавцов, которые продают на Авито цифровые товары (коды активации, ключи, промокоды, подписки).\nЧерез API можно получать заказы покупателей, отправлять цифровой товар, отменять заказ, эскалировать спор в арбитраж, выводить средства и подписаться на уведомления об изменении статуса заказа через webhook.\n**Авито API для бизнеса предоставляется согласно [Условиям использования](https://www.avito.ru/legal/pro_tools/public-api).**\n","title":"Цифровые товары","version":"1","x-skip-documentation":false},"openapi":"3.0.0","paths":{"/digital-goods/v1/orders":{"get":{"description":"Возвращает список заказов цифровых товаров текущего авторизованного продавца.\n\nВсе фильтры необязательны и комбинируются по «И». Фильтры-списки (`statuses`, `item_ids`, `buyer_ids`) передаются через запятую. Результат постранично ограничен параметрами `limit` и `offset`, признак наличия следующей страницы — в `pagination.hasMore`.\n","operationId":"getDigitalGoodsOrders","parameters":[{"$ref":"#/components/parameters/statuses"},{"$ref":"#/components/parameters/createdAtFrom"},{"$ref":"#/components/parameters/createdAtTo"},{"$ref":"#/components/parameters/updatedAtFrom"},{"$ref":"#/components/parameters/updatedAtTo"},{"$ref":"#/components/parameters/itemIds"},{"$ref":"#/components/parameters/buyerIds"},{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/offset"}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ordersResponse"}}},"description":"Список заказов получен"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Список заказов","tags":["DigitalGoods"],"x-rate-limiter":{"default":100}}},"/digital-goods/v1/orders/{order_id}":{"get":{"description":"Возвращает один заказ цифрового товара текущего авторизованного продавца.\n\nЕсли заказ принадлежит другому продавцу или не существует, возвращается `404`.\n","operationId":"getDigitalGoodsOrder","parameters":[{"$ref":"#/components/parameters/orderId"}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/order"}}},"description":"Заказ получен"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"404":{"$ref":"#/components/responses/notFound"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Заказ по идентификатору","tags":["DigitalGoods"],"x-rate-limiter":{"default":100}}},"/digital-goods/v1/orders/{order_id}/cancel":{"post":{"description":"Отменяет заказ до отправки товара — например, если товара не оказалось в наличии. Деньги возвращаются покупателю.\n\nМетод доступен, пока товар не отправлен; после отправки возвращается `409`.\n","operationId":"postDigitalGoodsOrderCancel","parameters":[{"$ref":"#/components/parameters/orderId"}],"responses":{"200":{"description":"Заказ отменен"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"404":{"$ref":"#/components/responses/notFound"},"409":{"$ref":"#/components/responses/conflict"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Отмена заказа продавцом","tags":["DigitalGoods"],"x-rate-limiter":{"default":30}}},"/digital-goods/v1/orders/{order_id}/escalate-to-arbitration":{"post":{"description":"Передаёт спор по заказу в арбитраж Авито, если договориться с покупателем напрямую не получилось. В `description` нужно описать ситуацию для поддержки.\n\nМетод доступен для заказа в статусе спора; в остальных статусах возвращается `409`.\n","operationId":"postDigitalGoodsOrderEscalateToArbitration","parameters":[{"$ref":"#/components/parameters/orderId"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/escalateToArbitrationRequest"}}},"description":"Комментарий к эскалации","required":true},"responses":{"200":{"description":"Проблема передана в арбитраж"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"404":{"$ref":"#/components/responses/notFound"},"409":{"$ref":"#/components/responses/conflict"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Эскалация спора в арбитраж","tags":["DigitalGoods"],"x-rate-limiter":{"default":30}}},"/digital-goods/v1/orders/{order_id}/history":{"get":{"description":"Возвращает историю переходов заказа между статусами в хронологическом порядке. Полезно, если уведомления webhook были пропущены и нужно восстановить, что происходило с заказом.\n","operationId":"getDigitalGoodsOrderHistory","parameters":[{"$ref":"#/components/parameters/orderId"}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/orderHistoryResponse"}}},"description":"История заказа получена"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"404":{"$ref":"#/components/responses/notFound"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"История статусов заказа","tags":["DigitalGoods"],"x-rate-limiter":{"default":100}}},"/digital-goods/v1/orders/{order_id}/payout":{"post":{"description":"Возвращает ссылку, по которой продавец может вывести деньги за завершённый заказ.\n\nМетод доступен, когда заказ завершён и средства разблокированы; иначе возвращается `409`.\n","operationId":"postDigitalGoodsOrderPayout","parameters":[{"$ref":"#/components/parameters/orderId"}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/payoutResponse"}}},"description":"Ссылка на вывод средств получена"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"404":{"$ref":"#/components/responses/notFound"},"409":{"$ref":"#/components/responses/conflict"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Ссылка на вывод средств по заказу","tags":["DigitalGoods"],"x-rate-limiter":{"default":30}}},"/digital-goods/v1/orders/{order_id}/send":{"post":{"description":"Отправляет покупателю текстовую инструкцию или код в чат по заказу и переводит заказ в статус `sent`.\n\nМетод доступен, пока заказ находится в статусе `in_progress`; в остальных статусах возвращается `409`.\n","operationId":"postDigitalGoodsOrderSend","parameters":[{"$ref":"#/components/parameters/orderId"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/sendProductRequest"}}},"description":"Текстовая инструкция для покупателя","required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/orderActionResponse"}}},"description":"Цифровой товар отправлен"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"404":{"$ref":"#/components/responses/notFound"},"409":{"$ref":"#/components/responses/conflict"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Отправка цифрового товара покупателю","tags":["DigitalGoods"],"x-rate-limiter":{"default":30}}},"/digital-goods/v1/webhook":{"delete":{"description":"Удаляет webhook-настройки текущего авторизованного продавца. Удаление отсутствующей настройки не является ошибкой.\n","operationId":"deleteWebhook","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/successResponse"}}},"description":"Webhook удален"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Отписка от уведомлений по заказам","tags":["DigitalGoods"],"x-rate-limiter":{"default":10}},"post":{"description":"Создаёт или обновляет webhook-настройки текущего авторизованного продавца.\n\nНа указанный `url` будут отправляться уведомления об изменении статусов заказов цифровых товаров. Каждое уведомление подписывается секретом `secret`, чтобы получатель мог проверить подлинность запроса.\n\nПовторный вызов перезаписывает ранее сохранённую настройку — отдельного метода обновления нет.\n","operationId":"createOrUpdateWebhook","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/webhookRequest"}}},"description":"Настройки webhook","required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/successResponse"}}},"description":"Webhook сохранен"},"400":{"$ref":"#/components/responses/badRequest"},"401":{"$ref":"#/components/responses/unauthorized"},"403":{"$ref":"#/components/responses/forbidden"},"500":{"$ref":"#/components/responses/internalServerError"}},"security":[{"ClientCredentials":[]}],"summary":"Подписка на уведомления по заказам","tags":["DigitalGoods"],"x-rate-limiter":{"default":10}}}},"servers":[{"url":"https://api.avito.ru/"}],"tags":[{"description":"Методы работы с заказами цифровых товаров и настройками webhook продавца.\n","name":"DigitalGoods","x-displayName":"Цифровые товары"}]}